<?xml version="1.0"?>
<!-- NXP Cup race hall: track from models/nxp_cup_track (see scripts/generate_track.py) -->
<sdf version="1.9">
  <world name="nxp_cup">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Indoor hall: one soft overhead light plus high ambient -->
    <light type="directional" name="hall_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1.0</direction>
    </light>

    <!-- Hall floor around the track -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.006 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.002 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://nxp_cup_track</uri>
      <name>track</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
