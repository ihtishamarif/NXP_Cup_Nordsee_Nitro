<?xml version="1.0"?>
<sdf version="1.9">
  <model name="nxp_cup_stop_obstacle">
    <!-- Not static: Styrofoam is light, so a touch from the car visibly moves it -->
    <link name="cube">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>0.06</mass>
        <inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
